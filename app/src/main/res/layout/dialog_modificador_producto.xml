<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Pollo.Tarjeta.Pedido"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <!-- Header Modal -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvModalProdName"
                android:textAppearance="@style/TextAppearance.Pollo.Titulo.Mediano"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1/4 de pollo frito" />

            <TextView
                android:id="@+id/tvModalProdPrice"
                android:textAppearance="@style/TextAppearance.Pollo.Precio.Pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                tools:text="Bs. 14.00" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseModifier"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_close"
            android:padding="6dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/char_400" />
    </RelativeLayout>

    <View
        style="@style/Widget.Pollo.Divisor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/label_opciones_rapidas_preparacion"
        android:textColor="@color/char_700"
        android:textSize="12.5sp" />

    <!-- Quick Chips Grid / Flow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipPierna"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/chip_modifier_pierna"
            android:textColor="@color/char_700"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipPechuga"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/chip_modifier_pechuga"
            android:textColor="@color/char_700"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipDorado"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/chip_modifier_bien_dorado"
            android:textColor="@color/char_700"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipSinEnsalada"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/chip_modifier_sin_ensalada"
            android:textColor="@color/char_700"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipSinAji"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/chip_modifier_sin_aji"
            android:textColor="@color/char_700"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipSalsaAparte"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/chip_modifier_salsa_aparte"
            android:textColor="@color/char_700"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="@string/label_nota_especial_comanda"
        android:textColor="@color/char_700"
        android:textSize="12.5sp" />

    <EditText
        android:id="@+id/etCustomNotes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="sans-serif"
        android:hint="@string/hint_nota_especial"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:paddingHorizontal="14dp"
        android:textColor="@color/char_900"
        android:textColorHint="@color/char_400"
        android:textSize="13sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelModifier"
            style="@style/Widget.Pollo.Boton.Contorno.Mediano"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_medium"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmModifier"
            style="@style/Widget.Pollo.Boton.Primario.Mediano"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_medium"
            android:layout_weight="1.6"
            android:text="@string/btn_add_to_order" />
    </LinearLayout>
</LinearLayout>
