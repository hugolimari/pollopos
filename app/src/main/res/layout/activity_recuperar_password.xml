<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50"
    tools:context=".RecuperarPasswordActivity">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnBack"
        style="@style/Widget.Pollo.Boton.Volver"
        android:layout_width="@dimen/btn_icon_size"
        android:layout_height="@dimen/btn_icon_size"
        android:layout_marginStart="@dimen/spacing_2xl"
        android:layout_marginTop="@dimen/spacing_3xl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:textAppearance="@style/TextAppearance.Pollo.Titulo.Grande"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginHorizontal="@dimen/spacing_3xl"
        android:text="@string/title_forgot_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDesc"
        android:textAppearance="@style/TextAppearance.Pollo.Cuerpo.Oscuro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:layout_marginHorizontal="@dimen/spacing_3xl"
        android:text="@string/desc_forgot_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- User Field Label -->
    <TextView
        android:id="@+id/lblUser"
        android:textAppearance="@style/TextAppearance.Pollo.Etiqueta.Negrita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_3xl"
        android:layout_marginStart="@dimen/spacing_3xl"
        android:text="@string/label_user"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDesc" />

    <!-- User Input Field -->
    <EditText
        android:id="@+id/etUser"
        style="@style/Widget.Pollo.CampoTexto"
        android:background="@drawable/bg_input_field"
        android:layout_width="0dp"
        android:layout_height="@dimen/input_height"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginHorizontal="@dimen/spacing_3xl"
        android:importantForAutofill="no"
        android:inputType="textPersonName"
        android:paddingHorizontal="@dimen/spacing_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblUser" />

    <!-- Send Code Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSendCode"
        style="@style/Widget.Pollo.Boton.Primario.Principal"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_height_hero"
        android:layout_marginTop="@dimen/spacing_4xl"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:text="@string/btn_send_recovery_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etUser" />

    <!-- Bottom Text: Remembered? -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSendCode">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/prompt_remembered_password"
            android:textColor="@color/char_900"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/btn_login"
            android:textColor="@color/ember_600"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/app_version"
        android:textColor="@color/char_900"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
