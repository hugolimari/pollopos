<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRecibo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50"
    tools:context=".ReciboActivity">

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/footerRecibo"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="36dp">

            <!-- Check Circle Icon -->
            <FrameLayout
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_check_circle">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/title_receipt_success"
                    android:src="@drawable/ic_check_green" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitleReceipt"
                android:textAppearance="@style/TextAppearance.Pollo.Title.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_receipt_success" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitleReceipt"
                android:textAppearance="@style/TextAppearance.Pollo.Subtitle.Emphasis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="26dp"
                android:text="Pedido cobrado con éxito" />

            <!-- Receipt Ticket Container -->
            <LinearLayout
                android:id="@+id/receiptCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_receipt_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Receipt Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tvReceiptBizName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/receipt_biz_name"
                        android:textColor="@color/char_900"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvReceiptMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="Sucursal Centro · 14 sep 2026, 1:42pm"
                        android:textColor="@color/char_400"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- Order Meta Rows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/receipt_label_order"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvReceiptOrderNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="#0001"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/receipt_label_type"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvReceiptOrderType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/receipt_type_takeaway"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/receipt_label_cashier"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvReceiptCashier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="Administrador"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- Items List Container -->
                <LinearLayout
                    android:id="@+id/layoutReceiptItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="1×  1/4 pollo frito"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="Bs. 14.00"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="1×  1/2 pollo a la brasa"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="Bs. 24.00"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="2×  Gaseosa 500ml"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="Bs. 8.00"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- Totals Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/receipt_label_subtotal"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvReceiptSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif"
                            android:text="Bs. 46.00"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/receipt_label_discount"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvReceiptDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif"
                            android:text="− Bs. 4.60"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line_color" />

                    <!-- Grand Total -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/receipt_label_total"
                            android:textColor="@color/char_900"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tvReceiptGrandTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-black"
                            android:text="Bs. 41.40"
                            android:textColor="@color/char_900"
                            android:textSize="17sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/receipt_label_received"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvReceiptAmountReceived"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif"
                            android:text="Bs. 50.00"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/receipt_label_change"
                            android:textColor="@color/char_700"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvReceiptChange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif"
                            android:text="Bs. 8.60"
                            android:textColor="@color/char_900"
                            android:textSize="12.5sp" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPrintReceipt"
                    style="@style/Widget.Pollo.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height_primary"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_printer"
                    android:drawablePadding="8dp"
                    android:text="@string/btn_print" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnWhatsappReceipt"
                    style="@style/Widget.Pollo.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height_primary"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_whatsapp"
                    android:drawablePadding="8dp"
                    android:text="@string/btn_whatsapp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Button -->
    <FrameLayout
        android:id="@+id/footerRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNewSale"
            style="@style/Widget.Pollo.Button.Primary.Hero"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_hero"
            android:text="@string/btn_new_sale" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>