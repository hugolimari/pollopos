<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainApertura"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paper_50">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Top Glow Effect -->
        <View
            android:id="@+id/glowView"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="@drawable/bg_glow_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:translationY="-140dp" />

        <!-- Brand / Header Section -->
        <LinearLayout
            android:id="@+id/headerApertura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_brand_logo"
                android:elevation="6dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="Apertura de turno"
                    android:src="@drawable/ic_cash_register"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:textAppearance="@style/TextAppearance.Pollo.Title.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apertura de Turno" />

            <TextView
                android:id="@+id/tvAperturaWelcome"
                android:textAppearance="@style/TextAppearance.Pollo.Subtitle.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Bienvenido, Cajero Principal" />
        </LinearLayout>

        <!-- Main Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardApertura"
            style="@style/Widget.Pollo.Card.White"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/spacing_s"
            app:layout_constraintTop_toBottomOf="@id/headerApertura">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dialog_padding">

                <TextView
                    android:textAppearance="@style/TextAppearance.Pollo.Title.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fondo Inicial de Caja" />

                <TextView
                    android:textAppearance="@style/TextAppearance.Pollo.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Ingresa el monto de efectivo con el que inicias operaciones en tu gaveta." />

                <!-- Amount Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="@color/paper_100"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Bs."
                        android:textColor="@color/ember_600"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/etFondoInicial"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical"
                        android:hint="100.00"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:text="100.00"
                        android:textColor="@color/char_900"
                        android:textColorHint="@color/placeholder_text"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Quick Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnQuickFondo50"
                        style="@style/Widget.Pollo.Button.QuickCash"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Bs. 50" />

                    <TextView
                        android:id="@+id/btnQuickFondo100"
                        style="@style/Widget.Pollo.Button.QuickCash"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Bs. 100" />

                    <TextView
                        android:id="@+id/btnQuickFondo200"
                        style="@style/Widget.Pollo.Button.QuickCash"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Bs. 200" />

                    <TextView
                        android:id="@+id/btnQuickFondo300"
                        style="@style/Widget.Pollo.Button.QuickCash"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Bs. 300" />
                </LinearLayout>

                <!-- Help Notice -->
                <TextView
                    style="@style/Widget.Pollo.Card.Order"
                    android:textAppearance="@style/TextAppearance.Pollo.Subtitle.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Este fondo se sumará a tus ventas en efectivo para calcular el arqueo final al cierre de turno." />

                <!-- Confirm Shift Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAbrirTurno"
                    style="@style/Widget.Pollo.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="22dp"
                    android:elevation="3dp"
                    android:text="Abrir Turno y Comenzar" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Footer -->
        <TextView
            android:textAppearance="@style/TextAppearance.Pollo.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xl"
            android:text="PolloPOS · Sucursal Centro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardApertura" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
