<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Pollo.Dialogo.Contenedor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tvFormTitle"
            android:textAppearance="@style/TextAppearance.Pollo.Titulo.Mediano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_food_menu" />

        <TextView
            android:id="@+id/tvFormSubtitle"
            android:textAppearance="@style/TextAppearance.Pollo.Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:text="@string/subtitle_add_food_menu" />

        <View
            style="@style/Widget.Pollo.Divisor"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp" />

        <!-- Nombre del Producto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_product_name_required"
            android:textColor="@color/char_700"
            android:textSize="12.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field">

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="@string/hint_product_name"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="@color/char_900"
                android:textColorHint="@color/placeholder_text"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Categoría -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_category_required"
            android:textColor="@color/char_700"
            android:textSize="12.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field">

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingHorizontal="12dp" />
        </FrameLayout>

        <!-- Precio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_price_required"
            android:textColor="@color/char_700"
            android:textSize="12.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field">

            <EditText
                android:id="@+id/etPrecio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="sans-serif-bold"
                android:hint="@string/zero_decimal"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textColor="@color/char_900"
                android:textColorHint="@color/placeholder_text"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_product_desc"
            android:textColor="@color/char_700"
            android:textSize="12.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field">

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="@string/hint_product_desc"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="@color/char_900"
                android:textColorHint="@color/placeholder_text"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Foto del plato (Almacenamiento Local en WebP) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_photo_product"
            android:textColor="@color/char_700"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_order_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/paper_100">

                <FrameLayout
                    android:id="@+id/cardPhotoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivFormPhotoPlaceholder"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/icon_muted" />

                    <ImageView
                        android:id="@+id/ivFormProductPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSelectPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_selected"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="14dp"
                    android:text="@string/btn_upload_photo_camera"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnRemovePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:padding="4dp"
                    android:text="@string/btn_remove_selected_photo"
                    android:textColor="@color/ember_600"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Emoji Selector (Salvavidas Opcional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_emoji_fallback"
            android:textColor="@color/char_700"
            android:textSize="12.5sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutEmojiSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/optNoEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/opt_no_emoji"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/optEmojiChicken"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="🍗"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/optEmojiFire"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="🔥"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/optEmojiDrink"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="🥤"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/optEmojiFries"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="🍟"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/optEmojiSalad"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="🥗"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/optEmojiBurger"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="🍖"
                    android:textSize="20sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Switch Disponible -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/label_enabled_for_sale"
                    android:textColor="@color/char_900"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/desc_enabled_for_sale"
                    android:textColor="@color/char_400"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDisponibleForm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/ember_600"
                app:trackTint="@color/ember_100" />
        </LinearLayout>

        <!-- Integrity Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_order_card"
            android:fontFamily="sans-serif"
            android:padding="10dp"
            android:text="@string/notice_product_integrity"
            android:textColor="@color/char_400"
            android:textSize="11sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelarForm"
                style="@style/Widget.Pollo.Boton.Contorno.Mediano"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height_medium"
                android:text="@string/btn_cancel" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuardarForm"
                style="@style/Widget.Pollo.Boton.Primario.Mediano"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height_medium"
                android:layout_marginStart="@dimen/spacing_m"
                android:paddingHorizontal="@dimen/spacing_2xl"
                android:text="@string/btn_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
