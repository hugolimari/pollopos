<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paper_50"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="600dp">

        <!-- Top Glow Effect -->
        <View
            android:id="@+id/glowView"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:background="@drawable/bg_glow_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:translationY="-120dp" />

        <!-- Brand Section -->
        <LinearLayout
            android:id="@+id/brandLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Logo Mark -->
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_brand_logo"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_flame_chicken" />
            </FrameLayout>

            <!-- Brand Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/brand_title_brasa"
                    android:textColor="@color/char_900"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/brand_title_pos"
                    android:textColor="@color/ember_600"
                    android:textSize="26sp" />
            </LinearLayout>

            <!-- Brand Subtitle -->
            <TextView
                android:textAppearance="@style/TextAppearance.Pollo.Subtitle.Emphasis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/brand_subtitle" />
        </LinearLayout>

        <!-- Main Form Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_card_top_rounded"
            android:elevation="@dimen/elevation_medium"
            android:paddingHorizontal="@dimen/spacing_2xl"
            android:paddingTop="@dimen/spacing_3xl"
            android:paddingBottom="@dimen/spacing_3xl"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brandLayout">

            <!-- Card Header -->
            <TextView
                android:id="@+id/tvWelcomeTitle"
                android:textAppearance="@style/TextAppearance.Pollo.Title.Large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/welcome_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvWelcomeSubtitle"
                android:textAppearance="@style/TextAppearance.Pollo.Subtitle.Emphasis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/welcome_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvWelcomeTitle" />

            <!-- User Field Label -->
            <TextView
                android:id="@+id/lblUser"
                android:textAppearance="@style/TextAppearance.Pollo.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:text="@string/label_user"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvWelcomeSubtitle" />

            <!-- User Field Input Box -->
            <FrameLayout
                android:id="@+id/wrapUser"
                style="@style/Widget.Pollo.InputContainer"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/spacing_s"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblUser">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/label_user"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/etUser"
                    style="@style/Widget.Pollo.EditText"
                    android:hint="@string/hint_user"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:paddingStart="48dp"
                    android:paddingEnd="16dp" />
            </FrameLayout>

            <!-- Password Field Label -->
            <TextView
                android:id="@+id/lblPassword"
                android:textAppearance="@style/TextAppearance.Pollo.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/label_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/wrapUser" />

            <!-- Password Field Input Box -->
            <FrameLayout
                android:id="@+id/wrapPassword"
                style="@style/Widget.Pollo.InputContainer"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/spacing_s"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblPassword">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/label_password"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/Widget.Pollo.EditText"
                    android:hint="@string/hint_password"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />

                <ImageButton
                    android:id="@+id/btnToggleEye"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/label_password"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <!-- Forgot PIN Link -->
            <TextView
                android:id="@+id/tvForgotPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="4dp"
                android:text="@string/forgot_pin"
                android:textColor="@color/ember_600"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/wrapPassword" />

            <!-- Primary Button: Iniciar turno -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStartShift"
                style="@style/Widget.Pollo.Button.Primary.Hero"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:text="@string/btn_start_shift"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvForgotPin" />

            <!-- Footer Note -->
            <TextView
                android:id="@+id/tvFooterNote"
                android:textAppearance="@style/TextAppearance.Pollo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4xl"
                android:text="@string/footer_note"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnStartShift" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>