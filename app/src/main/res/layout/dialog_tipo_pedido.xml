<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_order_card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Modal -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnDismissModal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Modalidad del pedido"
                android:textColor="@color/char_900"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Selecciona cómo se entregará la orden"
                android:textColor="@color/char_400"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnDismissModal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Cerrar"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/char_400" />
    </RelativeLayout>

    <!-- Card 1: Consumo en el Local -->
    <LinearLayout
        android:id="@+id/cardOptionLocal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_mode_selected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/iconContainerLocal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle">

            <ImageView
                android:id="@+id/ivModalIconLocal"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="En el local"
                android:src="@drawable/ic_dining_local"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Consumo en el local"
                android:textColor="@color/char_900"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Servir en bandeja o plato para el salón"
                android:textColor="@color/char_400"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radioLocalIndicator"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Seleccionado"
            android:src="@drawable/ic_check_circle_ember" />
    </LinearLayout>

    <!-- Card 2: Para Llevar -->
    <LinearLayout
        android:id="@+id/cardOptionLlevar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_card_mode_unselected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/iconContainerLlevar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn">

            <ImageView
                android:id="@+id/ivModalIconLlevar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Para llevar"
                android:src="@drawable/ic_takeaway_bag"
                app:tint="@color/char_700" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Para llevar"
                android:textColor="@color/char_900"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Empacar en bolsa y recipientes térmicos"
                android:textColor="@color/char_400"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radioLlevarIndicator"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="No seleccionado"
            android:src="@drawable/ic_circle_outline" />
    </LinearLayout>

    <!-- Resumen rápido del pedido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_change_row"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvModalCartSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="0 productos seleccionados"
            android:textColor="@color/char_700"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvModalTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Bs. 0.00"
            android:textColor="@color/ember_600"
            android:textSize="14.5sp" />
    </LinearLayout>

    <!-- Botón de Confirmación -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmOrderMode"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_primary"
        android:fontFamily="sans-serif-bold"
        android:stateListAnimator="@null"
        android:text="Continuar a Cobrar →"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp" />
</LinearLayout>
