<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainCropLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16181C">

    <!-- Barra Superior -->
    <LinearLayout
        android:id="@+id/topBarCrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F2228"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnCancelCrop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancelar"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Recortar foto del menú"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCropSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Proporción recomendada: 4:3"
                android:textColor="#A0A6B2"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDoneCrop"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="18dp"
            android:text="Listo"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Área de Recorte Interactiva -->
    <com.example.pollogithub.ui.widget.CustomCropView
        android:id="@+id/customCropView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBarCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarCrop" />

    <!-- Barra Inferior de Opciones -->
    <LinearLayout
        android:id="@+id/bottomBarCrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F2228"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif"
            android:text="Arrastra y pellizca para encuadrar la comida"
            android:textColor="#88909E"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Selector de Proporción 4:3 (Menú) -->
            <TextView
                android:id="@+id/chipRatio43"
                style="@style/Widget.Pollo.Chip.Selected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="4:3 Menú" />

            <!-- Selector de Proporción 1:1 (Cuadrado) -->
            <TextView
                android:id="@+id/chipRatio11"
                style="@style/Widget.Pollo.Chip.Unselected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="1:1 Cuadrado" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="12dp"
                android:background="#3A3E48" />

            <!-- Botón de Rotación 90° -->
            <LinearLayout
                android:id="@+id/btnRotateCrop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_outline"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_rotate"
                    app:tint="@color/char_900" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Girar 90°"
                    android:textColor="@color/char_900"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
