<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainCropLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crop_bg">

    <!-- Barra Superior -->
    <LinearLayout
        android:id="@+id/topBarCrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/crop_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnCancelCrop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_cancelar"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/titulo_recortar_foto_menu"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCropSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/recorte_proporcion_recomendada_desc"
                android:textColor="@color/crop_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDoneCrop"
            style="@style/Widget.Pollo.Boton.Primario.Pequeno"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height_small"
            android:paddingHorizontal="18dp"
            android:text="@string/btn_listo" />
    </LinearLayout>

    <!-- Área de Recorte Interactiva -->
    <com.example.pollogithub.ui.widget.CustomCropView
        android:id="@+id/customCropView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBarCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarCrop" />

    <!-- Barra Inferior de Opciones -->
    <LinearLayout
        android:id="@+id/bottomBarCrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/crop_bar_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif"
            android:text="@string/recorte_instrucciones_arrastrar_pellizcar"
            android:textColor="@color/crop_text_muted"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Selector de Proporción 4:3 (Menú) -->
            <TextView
                android:id="@+id/chipRatio43"
                style="@style/Widget.Pollo.Chip.Seleccionado"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/chip_proporcion_4_3" />

            <!-- Selector de Proporción 1:1 (Cuadrado) -->
            <TextView
                android:id="@+id/chipRatio11"
                style="@style/Widget.Pollo.Chip.NoSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="@string/chip_proporcion_1_1" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/crop_divider" />

            <!-- Botón de Rotación 90° -->
            <LinearLayout
                android:id="@+id/btnRotateCrop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_outline"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_rotate"
                    app:tint="@color/char_900" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/btn_girar_90"
                    android:textColor="@color/char_900"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
