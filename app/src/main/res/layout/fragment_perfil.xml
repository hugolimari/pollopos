<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerPerfil"
        style="@style/EncabezadoVertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:textAppearance="@style/TituloMediano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_perfil_usuario" />

        <TextView
            android:textAppearance="@style/TextoSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:text="@string/subtitulo_perfil_usuario" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPerfil">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Profile Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_order_card"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Avatar Badge -->
                <TextView
                    android:id="@+id/tvProfileAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/inicial_usuario_c"
                    android:textColor="@color/white"
                    android:textSize="28sp" />

                <!-- Cashier Name -->
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/rol_admin"
                    android:textColor="@color/char_900"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/admin_sistema"
                    android:textColor="@color/ember_600"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/info_turno_ejemplo"
                    android:textColor="@color/char_400"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Card Total Ventas -->
                <LinearLayout
                    style="@style/TarjetaEstadistica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/etiqueta_ventas_de_hoy"
                        android:textColor="@color/char_400"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvProfileVentasHoy"
                        style="@style/TextoEstadisticaNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/cero_moneda" />
                </LinearLayout>

                <!-- Card Total Pedidos -->
                <LinearLayout
                    style="@style/TarjetaEstadistica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/etiqueta_pedidos_cobrados"
                        android:textColor="@color/char_400"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvProfilePedidosCobrados"
                        style="@style/TextoEstadisticaNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/cero_pedidos"
                        android:textColor="@color/ember_700" />
                </LinearLayout>
            </LinearLayout>

            <!-- Actions List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_order_card"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- 1. Gestión de Menú y Productos (Comida) -->
                <TextView
                    android:id="@+id/btnGestionMenu"
                    style="@style/FilaOpcionPerfil"
                    android:drawableStart="@drawable/ic_flame_chicken"
                    android:drawableTint="@color/ember_700"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/item_gestion_menu"
                    android:textColor="@color/ember_700" />

                <!-- 2. Movimientos de Caja Chica (Gastos / Ingresos) -->
                <TextView
                    android:id="@+id/btnMovimientoCaja"
                    style="@style/FilaOpcionPerfil"
                    android:drawableStart="@drawable/ic_cash_register"
                    android:drawableTint="@color/char_700"
                    android:text="@string/item_movimientos_caja" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- 4. Historial de Turnos y Cierres -->
                <TextView
                    android:id="@+id/btnHistorialTurnos"
                    style="@style/FilaOpcionPerfil"
                    android:drawableStart="@drawable/ic_clock"
                    android:drawableTint="@color/char_700"
                    android:text="@string/item_historial_turnos" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- 5. Detalle del turno actual -->
                <TextView
                    android:id="@+id/btnShiftDetails"
                    style="@style/FilaOpcionPerfil"
                    android:drawableStart="@drawable/ic_cash_register"
                    android:drawableTint="@color/char_700"
                    android:text="@string/item_detalles_turno_activo" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- 6. Impresora Térmica -->
                <TextView
                    android:id="@+id/btnPrinterStatus"
                    style="@style/FilaOpcionPerfil"
                    android:drawableStart="@drawable/ic_printer"
                    android:drawableTint="@color/char_700"
                    android:text="@string/item_configurar_impresora" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- 7. App Version -->
                <TextView
                    android:id="@+id/btnAppVersion"
                    style="@style/FilaOpcionPerfil"
                    android:drawableStart="@drawable/ic_check_green"
                    android:drawableTint="@color/char_400"
                    android:text="@string/item_app_version_offline" />
            </LinearLayout>

            <!-- Close Shift Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCloseShift"
                style="@style/BotonPrimario"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height_primary"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/btn_cerrar_turno_caja" />

            <!-- Logout Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                style="@style/BotonContorno"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height_primary"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/btn_cerrar_sesion" />

            <!-- Brand Signature Footer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_brand_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/char_400"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>