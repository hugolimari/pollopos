<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainGestionProductos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerGestion"
            style="@style/Widget.Pollo.Encabezado.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBackGestion"
                style="@style/Widget.Pollo.Boton.Volver"
                android:layout_width="@dimen/btn_icon_size"
                android:layout_height="@dimen/btn_icon_size" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:textAppearance="@style/TextAppearance.Pollo.Titulo.Mediano"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo_gestion_menu" />

                <TextView
                    android:id="@+id/tvTotalCountSubtitle"
                    android:textAppearance="@style/TextAppearance.Pollo.Subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2xs"
                    android:text="@string/subtitulo_gestion_menu" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search Bar -->
        <FrameLayout
            android:id="@+id/wrapSearchGestion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search"
            app:layout_constraintTop_toBottomOf="@id/headerGestion">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/desc_buscar"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearchGestion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="@string/pista_buscar_producto"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="44dp"
                android:paddingEnd="16dp"
                android:textColor="@color/char_900"
                android:textColorHint="@color/placeholder_text"
                android:textSize="13.5sp" />
        </FrameLayout>

        <!-- Category Horizontal Scroll -->
        <HorizontalScrollView
            android:id="@+id/scrollCategoryChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/wrapSearchGestion">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/categoria_todos"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPolloFrito"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/categoria_pollo_frito"
                    android:textColor="@color/char_700"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipBrasa"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/categoria_a_la_brasa"
                    android:textColor="@color/char_700"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipCombos"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/categoria_combos"
                    android:textColor="@color/char_700"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipBebidas"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/categoria_bebidas"
                    android:textColor="@color/char_700"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipAcompanamientos"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/categoria_acompanamientos"
                    android:textColor="@color/char_700"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Product List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProductosGestion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="84dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollCategoryChips" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Action Button: Add Product -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:backgroundTint="@color/ember_600"
        android:elevation="6dp"
        android:fontFamily="sans-serif-bold"
        android:text="@string/btn_anadir_comida"
        android:textColor="@color/white"
        app:icon="@drawable/ic_plus"
        app:iconTint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
