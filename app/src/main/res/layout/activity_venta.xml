<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainVenta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50"
    tools:context=".VentaActivity">

    <!-- Header Area -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/elevation_low"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/header_padding_horizontal"
        android:paddingTop="@dimen/header_padding_top"
        android:paddingBottom="@dimen/header_padding_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Row: Avatar, Venue Info, Notification Bell -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/header_padding_bottom">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Avatar Circle -->
                <TextView
                    android:id="@+id/tvAvatarHeader"
                    android:layout_width="@dimen/avatar_size_small"
                    android:layout_height="@dimen/avatar_size_small"
                    android:background="@drawable/bg_avatar_circle"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/user_initial_c"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <!-- Cashier & Shift Info -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCashierName"
                        style="@style/TextAppearance.Pollo.Title.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carlos Mendoza" />

                    <TextView
                        android:id="@+id/tvShiftInfo"
                        style="@style/TextAppearance.Pollo.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shift_info" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Search Input Bar -->
        <FrameLayout
            style="@style/Widget.Pollo.SearchContainer">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="@dimen/input_padding_horizontal"
                android:contentDescription="@string/search_hint"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearch"
                style="@style/Widget.Pollo.EditText"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="42dp"
                android:paddingEnd="@dimen/input_padding_horizontal" />
        </FrameLayout>
    </LinearLayout>

    <!-- Category Chips Scroll -->
    <HorizontalScrollView
        android:id="@+id/scrollCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:clipToPadding="false"
        android:elevation="1dp"
        android:paddingHorizontal="@dimen/header_padding_horizontal"
        android:paddingVertical="@dimen/spacing_m"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:id="@+id/layoutChipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTodos"
                style="@style/Widget.Pollo.Chip.Selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="Todos" />

            <TextView
                android:id="@+id/chipPolloFrito"
                style="@style/Widget.Pollo.Chip.Unselected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="Pollo frito" />

            <TextView
                android:id="@+id/chipBrasa"
                style="@style/Widget.Pollo.Chip.Unselected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="A la brasa" />

            <TextView
                android:id="@+id/chipCombos"
                style="@style/Widget.Pollo.Chip.Unselected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="Combos" />

            <TextView
                android:id="@+id/chipAcompanamientos"
                style="@style/Widget.Pollo.Chip.Unselected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="Acompañamientos" />

            <TextView
                android:id="@+id/chipBebidas"
                style="@style/Widget.Pollo.Chip.Unselected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="Bebidas" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Products Scroll Section -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="130dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/scrollCategories">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/card_padding_standard"
            android:paddingTop="@dimen/spacing_l">

            <TextView
                android:id="@+id/tvSectionTitle"
                style="@style/TextAppearance.Pollo.Title.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:text="@string/section_title_fried" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="6"
                tools:listitem="@layout/item_product_card" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Cart Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cartBar"
        style="@style/Widget.Pollo.CartBar"
        android:layout_marginHorizontal="@dimen/header_padding_horizontal"
        android:layout_marginBottom="@dimen/spacing_m"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Cart Count Badge -->
            <TextView
                android:id="@+id/tvCartCount"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_cart_count"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <!-- Cart Info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Pollo.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cart_total_label"
                    android:textColor="@color/cart_label" />

                <TextView
                    android:id="@+id/tvCartTotal"
                    style="@style/TextAppearance.Pollo.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs. 68.50"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- CTA View Order Button -->
        <LinearLayout
            android:id="@+id/btnViewOrder"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height_small"
            android:background="@drawable/bg_cart_cta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_l"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/cart_view_order"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cart_view_order"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        style="@style/Widget.Pollo.BottomNav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Item Venta -->
        <LinearLayout
            android:id="@+id/navItemVenta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_sale"
                android:src="@drawable/ic_nav_sale"
                app:tint="@color/ember_600" />

            <TextView
                style="@style/TextAppearance.Pollo.Nav.Active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_sale" />
        </LinearLayout>

        <!-- Item Pedidos -->
        <LinearLayout
            android:id="@+id/navItemPedidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_orders"
                android:src="@drawable/ic_nav_orders"
                app:tint="@color/char_400" />

            <TextView
                style="@style/TextAppearance.Pollo.Nav.Inactive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_orders" />
        </LinearLayout>

        <!-- Item Reportes -->
        <LinearLayout
            android:id="@+id/navItemReportes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_reports"
                android:src="@drawable/ic_nav_reports"
                app:tint="@color/char_400" />

            <TextView
                style="@style/TextAppearance.Pollo.Nav.Inactive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_reports" />
        </LinearLayout>

        <!-- Item Perfil -->
        <LinearLayout
            android:id="@+id/navItemPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/nav_profile"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/char_400" />

            <TextView
                style="@style/TextAppearance.Pollo.Nav.Inactive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>