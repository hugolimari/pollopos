<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50">

    <!-- Header Area -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/elevation_low"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/header_padding_horizontal"
        android:paddingTop="@dimen/header_padding_top"
        android:paddingBottom="@dimen/header_padding_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/header_padding_bottom">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAvatarHeader"
                    android:layout_width="@dimen/avatar_size_small"
                    android:layout_height="@dimen/avatar_size_small"
                    android:background="@drawable/bg_avatar_circle"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/inicial_usuario_c"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCashierName"
                        style="@style/TituloPequeno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rol_admin" />

                    <TextView
                        android:id="@+id/tvShiftInfo"
                        style="@style/TextoSubtitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/info_turno" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Selector de Modalidad: En el local vs Para llevar -->
        <LinearLayout
            android:id="@+id/layoutOrderModeSelector"
            style="@style/ContenedorSegmentado"
            android:layout_marginBottom="@dimen/spacing_m">

            <LinearLayout
                android:id="@+id/btnHeaderModeLocal"
                style="@style/SegmentoActivo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHeaderIconLocal"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/modo_pedido_local"
                    android:src="@drawable/ic_dining_local"
                    app:tint="@color/ember_600" />

                <TextView
                    android:id="@+id/tvHeaderTextLocal"
                    style="@style/SegmentoActivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@null"
                    android:text="@string/modo_pedido_local" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHeaderModeLlevar"
                style="@style/SegmentoInactivo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHeaderIconLlevar"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/modo_pedido_llevar"
                    android:src="@drawable/ic_takeaway_bag"
                    app:tint="@color/char_400" />

                <TextView
                    android:id="@+id/tvHeaderTextLlevar"
                    style="@style/SegmentoInactivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@null"
                    android:text="@string/modo_pedido_llevar" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            style="@style/ContenedorBusqueda"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height_compact">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="@dimen/input_padding_horizontal"
                android:contentDescription="@string/pista_buscar"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearch"
                style="@style/CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/pista_buscar"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="42dp"
                android:paddingEnd="@dimen/input_padding_horizontal" />
        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scrollCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:clipToPadding="false"
        android:elevation="1dp"
        android:paddingHorizontal="@dimen/header_padding_horizontal"
        android:paddingVertical="@dimen/spacing_m"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:id="@+id/layoutChipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTodos"
                style="@style/ChipSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/categoria_todos" />

            <TextView
                android:id="@+id/chipPolloFrito"
                style="@style/ChipNoSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/categoria_pollo_frito" />

            <TextView
                android:id="@+id/chipBrasa"
                style="@style/ChipNoSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/categoria_a_la_brasa" />

            <TextView
                android:id="@+id/chipCombos"
                style="@style/ChipNoSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/categoria_combos" />

            <TextView
                android:id="@+id/chipAcompanamientos"
                style="@style/ChipNoSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/categoria_acompanamientos" />

            <TextView
                android:id="@+id/chipBebidas"
                style="@style/ChipNoSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/categoria_bebidas" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollCategories">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/card_padding_standard"
            android:paddingTop="@dimen/spacing_l">

            <TextView
                android:id="@+id/tvSectionTitle"
                style="@style/TituloPequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:text="@string/seccion_titulo_frito" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="6"
                tools:listitem="@layout/item_product_card" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Cart Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cartBar"
        style="@style/BarraCarrito"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginHorizontal="@dimen/header_padding_horizontal"
        android:layout_marginBottom="@dimen/spacing_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvCartCount"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_cart_count"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                tools:text="3"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoLeyenda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etiqueta_total_carrito"
                    android:textColor="@color/cart_label" />

                <TextView
                    android:id="@+id/tvCartTotal"
                    style="@style/TextoPrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Bs. 68.50"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnViewOrder"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height_small"
            android:background="@drawable/bg_cart_cta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_l"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/ver_pedido_carrito"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/ver_pedido_carrito"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>