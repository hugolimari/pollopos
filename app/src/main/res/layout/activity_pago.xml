<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainPago"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50"
    tools:context=".PagoActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_btn"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back_arrow" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/title_pay"
                android:textColor="@color/char_900"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/subtitle_pay"
                android:textColor="@color/char_400"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/footerPago"
        app:layout_constraintTop_toBottomOf="@id/headerPago">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Total Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/label_total_to_pay"
                    android:textColor="@color/char_400"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Bs."
                        android:textColor="@color/ember_600"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="41.40"
                        android:textColor="@color/char_900"
                        android:textSize="38sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/section_payment_method"
                android:textColor="@color/char_700"
                android:textSize="12.5sp" />

            <!-- Payment Methods Grid (2x2) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Method Efectivo -->
                <LinearLayout
                    android:id="@+id/methodEfectivo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_method_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <FrameLayout
                        android:id="@+id/iconEfectivo"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_method_icon_selected">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/method_cash"
                            android:src="@drawable/ic_method_cash" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtEfectivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/method_cash"
                        android:textColor="@color/char_700"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Method Tarjeta -->
                <LinearLayout
                    android:id="@+id/methodTarjeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_method_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <FrameLayout
                        android:id="@+id/iconTarjeta"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/method_card"
                            android:src="@drawable/ic_method_card" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTarjeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/method_card"
                        android:textColor="@color/char_700"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Method QR -->
                <LinearLayout
                    android:id="@+id/methodQR"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_method_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <FrameLayout
                        android:id="@+id/iconQR"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/method_qr"
                            android:src="@drawable/ic_method_qr" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtQR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/method_qr"
                        android:textColor="@color/char_700"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Method Mixto -->
                <LinearLayout
                    android:id="@+id/methodMixto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_method_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <FrameLayout
                        android:id="@+id/iconMixto"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/method_mixed"
                            android:src="@drawable/ic_method_mixed" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtMixto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/method_mixed"
                        android:textColor="@color/char_700"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </GridLayout>

            <!-- Cash Panel -->
            <LinearLayout
                android:id="@+id/cashPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cash_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/label_amount_received"
                    android:textColor="@color/char_700"
                    android:textSize="12sp" />

                <!-- Cash Input Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_cash_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Bs."
                        android:textColor="@color/char_400"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/etAmountReceived"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif-bold"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="8dp"
                        android:text="50.00"
                        android:textColor="@color/char_900"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Quick Cash Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuickExact"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quick_cash_btn"
                        android:fontFamily="sans-serif-bold"
                        android:text="Exacto"
                        android:textAllCaps="false"
                        android:textColor="@color/char_700"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuick45"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quick_cash_btn"
                        android:fontFamily="sans-serif-bold"
                        android:text="Bs. 45"
                        android:textAllCaps="false"
                        android:textColor="@color/char_700"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuick50"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quick_cash_btn"
                        android:fontFamily="sans-serif-bold"
                        android:text="Bs. 50"
                        android:textAllCaps="false"
                        android:textColor="@color/char_700"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuick100"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quick_cash_btn"
                        android:fontFamily="sans-serif-bold"
                        android:text="Bs. 100"
                        android:textAllCaps="false"
                        android:textColor="@color/char_700"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Change Due Row -->
                <LinearLayout
                    android:id="@+id/changeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_change_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/label_change_due"
                        android:textColor="@color/ok_600"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvChangeDue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Bs. 8.60"
                        android:textColor="@color/ok_600"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Confirm Button -->
    <FrameLayout
        android:id="@+id/footerPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmPayment"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="4dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/btn_confirm_payment"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>