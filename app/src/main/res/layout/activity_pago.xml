<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainPago"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50"
    tools:context=".PagoActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerPago"
        style="@style/EncabezadoHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/BotonVolver"
            android:layout_width="@dimen/btn_icon_size"
            android:layout_height="@dimen/btn_icon_size" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TituloMediano"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_cobrar" />

            <TextView
                android:id="@+id/tvPaymentSubtitle"
                android:textAppearance="@style/TextoSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitulo_cobrar" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/footerPago"
        app:layout_constraintTop_toBottomOf="@id/headerPago">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Total Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/etiqueta_total_a_cobrar"
                    android:textColor="@color/char_400"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/moneda_bs"
                        android:textColor="@color/ember_600"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        tools:text="41.40"
                        android:textColor="@color/char_900"
                        android:textSize="38sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOriginalSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Subtotal: Bs. 41.40"
                    android:textColor="@color/char_400"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Descuento o Promoción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/etiqueta_descuento_promocion"
                android:textColor="@color/char_700"
                android:textSize="12.5sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipDesc0"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_selected"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/chip_sin_descuento"
                        android:textColor="@color/white"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/chipDesc5"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/chip_descuento_5"
                        android:textColor="@color/char_700"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/chipDesc10"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/chip_descuento_10"
                        android:textColor="@color/char_700"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/chipDesc15"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/chip_descuento_15"
                        android:textColor="@color/char_700"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/chipDesc20"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/chip_descuento_20"
                        android:textColor="@color/char_700"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/chipDescCortesia"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/chip_descuento_cortesia"
                        android:textColor="@color/char_700"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/seccion_metodo_pago"
                android:textColor="@color/char_700"
                android:textSize="12.5sp" />

            <!-- Payment Methods Grid (2x2) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Method Efectivo -->
                <LinearLayout
                    android:id="@+id/methodEfectivo"
                    style="@style/TarjetaMetodoPago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_method_selected">

                    <FrameLayout
                        android:id="@+id/iconEfectivo"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_method_icon_selected">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/metodo_efectivo"
                            android:src="@drawable/ic_method_cash" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtEfectivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/metodo_efectivo"
                        android:textColor="@color/char_700"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Method Tarjeta -->
                <LinearLayout
                    android:id="@+id/methodTarjeta"
                    style="@style/TarjetaMetodoPago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_method_unselected">

                    <FrameLayout
                        android:id="@+id/iconTarjeta"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/metodo_tarjeta"
                            android:src="@drawable/ic_method_card" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTarjeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/metodo_tarjeta"
                        android:textColor="@color/char_700"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Method QR -->
                <LinearLayout
                    android:id="@+id/methodQR"
                    style="@style/TarjetaMetodoPago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_method_unselected">

                    <FrameLayout
                        android:id="@+id/iconQR"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/metodo_qr"
                            android:src="@drawable/ic_method_qr" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtQR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/metodo_qr"
                        android:textColor="@color/char_700"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Method Mixto -->
                <LinearLayout
                    android:id="@+id/methodMixto"
                    style="@style/TarjetaMetodoPago"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_method_unselected">

                    <FrameLayout
                        android:id="@+id/iconMixto"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/metodo_mixto"
                            android:src="@drawable/ic_method_mixed" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtMixto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/metodo_mixto"
                        android:textColor="@color/char_700"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </GridLayout>

            <!-- Cash Panel -->
            <LinearLayout
                android:id="@+id/cashPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cash_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/etiqueta_monto_recibido"
                    android:textColor="@color/char_700"
                    android:textSize="12sp" />

                <!-- Cash Input Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_cash_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/moneda_bs"
                        android:textColor="@color/char_400"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/etAmountReceived"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif-bold"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="8dp"
                        tools:text="50.00"
                        android:textColor="@color/char_900"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Quick Cash Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuickExact"
                        style="@style/BotonEfectivoRapido"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1.2"
                        android:text="@string/btn_rapido_exacto" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuick20"
                        style="@style/BotonEfectivoRapido"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_rapido_mas_20" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuick50"
                        style="@style/BotonEfectivoRapido"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_rapido_mas_50" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuick100"
                        style="@style/BotonEfectivoRapido"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_rapido_mas_100" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuick200"
                        style="@style/BotonEfectivoRapido"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/btn_rapido_mas_200" />
                </LinearLayout>

                <!-- Change Due Row -->
                <LinearLayout
                    android:id="@+id/changeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_change_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/etiqueta_vuelto_entregar"
                        android:textColor="@color/ok_600"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvChangeDue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        tools:text="Bs. 8.60"
                        android:textColor="@color/ok_600"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Panel Pago Mixto (Efectivo + Electrónico) -->
            <LinearLayout
                android:id="@+id/panelMixto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cash_panel"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/titulo_desglose_mixto"
                    android:textColor="@color/char_900"
                    android:textSize="13sp" />

                <!-- Campo Efectivo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/etiqueta_parte_efectivo"
                    android:textColor="@color/char_700"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_cash_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/moneda_bs"
                        android:textColor="@color/char_400"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etMixtoEfectivo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:fontFamily="sans-serif-bold"
                        android:hint="@string/cero_decimal"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="8dp"
                        android:textColor="@color/char_900"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Campo Digital -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/etiqueta_parte_electronica"
                    android:textColor="@color/char_700"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_cash_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/moneda_bs"
                        android:textColor="@color/char_400"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etMixtoDigital"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:fontFamily="sans-serif-bold"
                        android:hint="@string/cero_decimal"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="8dp"
                        android:textColor="@color/char_900"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Resumen Mixto -->
                <TextView
                    android:id="@+id/tvMixtoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="@string/desc_ingresa_montos_mixto"
                    android:textColor="@color/ember_600"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Confirm Button -->
    <FrameLayout
        android:id="@+id/footerPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmPayment"
            style="@style/BotonPrimarioPrincipal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_hero"
            android:text="@string/btn_confirmar_pago" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>