<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DialogoContenedor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:textAppearance="@style/TituloMediano"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_foto_producto" />

    <TextView
        android:textAppearance="@style/TextoSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xs"
        android:text="@string/subtitulo_seleccionar_origen_foto" />

    <View
        style="@style/Divisor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp" />

    <!-- Opción 1: Cámara -->
    <LinearLayout
        android:id="@+id/btnOptionCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_order_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/ember_600" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/opcion_tomar_foto_camara"
                android:textColor="@color/char_900"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/desc_tomar_foto_camara"
                android:textColor="@color/char_400"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/char_400" />
    </LinearLayout>

    <!-- Opción 2: Galería -->
    <LinearLayout
        android:id="@+id/btnOptionGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_order_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_gallery"
            app:tint="@color/info_600" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/opcion_elegir_de_galeria"
                android:textColor="@color/char_900"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/desc_elegir_de_galeria"
                android:textColor="@color/char_400"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/char_400" />
    </LinearLayout>

    <!-- Cancelar -->
    <TextView
        android:id="@+id/btnCancelSource"
        style="@style/BotonContornoMediano"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height_medium"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/btn_cancelar" />

</LinearLayout>
