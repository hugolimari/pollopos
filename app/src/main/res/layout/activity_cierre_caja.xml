<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paper_50"
    tools:context=".CierreCajaActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="48dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_back_btn"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header Titles -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Cierre de caja"
            android:textColor="@color/char_900"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Turno de Hugo Daza - 9:01am - 6:20pm"
            android:textColor="@color/char_700"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <View
            android:id="@+id/dividerTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <!-- Resumen del turno -->
        <TextView
            android:id="@+id/lblResumen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="Resumen del turno"
            android:textColor="@color/char_900"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerTop" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/paper_50"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line_color"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/lblResumen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvResumenSucursalFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-medium"
                    android:text="Sucursal Centro"
                    android:textColor="@color/char_700"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/paper_100" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Ventas en efectivo" android:textSize="12sp" android:textColor="@color/char_700" />
                    <TextView android:id="@+id/tvResumenEfectivo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bs. 0.00" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/char_900" />
                </LinearLayout>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Ventas con tarjeta" android:textSize="12sp" android:textColor="@color/char_700" />
                    <TextView android:id="@+id/tvResumenTarjeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bs. 0.00" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/char_900" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Ventas QR" android:textSize="12sp" android:textColor="@color/char_700" />
                    <TextView android:id="@+id/tvResumenQr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bs. 0.00" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/char_900" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/paper_100" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Total vendido" android:textSize="12sp" android:textColor="@color/char_700" />
                    <TextView android:id="@+id/tvResumenTotalVendido" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bs. 0.00" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/char_900" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Fondo inicial de caja" android:textSize="12sp" android:textColor="@color/char_700" />
                    <TextView android:id="@+id/tvResumenFondoInicial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bs. 0.00" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/char_900" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Efectivo esperado en caja" android:textSize="12sp" android:textColor="@color/char_700" />
                    <TextView android:id="@+id/tvResumenEsperado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bs. 0.00" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/char_900" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Conteo de efectivo -->
        <TextView
            android:id="@+id/lblConteo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="Conteo de efectivo"
            android:textColor="@color/char_900"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardResumen" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardConteo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/paper_50"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line_color"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/lblConteo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="¿Cuánto dinero en efectivo hay en caja?"
                    android:textColor="@color/char_900"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="@color/ember_100"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Bs."
                        android:textColor="@color/char_900"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/etConteo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical|end"
                        android:inputType="numberDecimal"
                        android:text=""
                        android:textColor="@color/char_900"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Alert Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/ok_100"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardConteo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvAlertTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Caja cuadrada"
                    android:textColor="@color/ok_600"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAlertMonto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Bs. 0.00"
                    android:textColor="@color/char_900"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvAlertDescripcion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="El efectivo contado coincide con el esperado."
                    android:textColor="@color/char_900"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Confirm Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-bold"
            android:text="Confirmar cierre de turno"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAlert" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:text="V1.2"
            android:textColor="@color/char_900"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnConfirm" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
