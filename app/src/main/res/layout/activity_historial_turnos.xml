<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainHistorialTurnos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerHistorial"
        style="@style/EncabezadoHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackHistorial"
            style="@style/BotonVolver"
            android:layout_width="@dimen/btn_icon_size"
            android:layout_height="@dimen/btn_icon_size" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TituloMediano"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_historial_turnos" />

            <TextView
                android:id="@+id/tvTurnosSubtitle"
                android:textAppearance="@style/TextoSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/subtitulo_historial_turnos" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyTurnos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerHistorial">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/sin_turnos_registrados"
            android:textColor="@color/char_900"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="@string/desc_turnos_apareceran_aqui"
            android:textColor="@color/char_400"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Turnos List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTurnosHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerHistorial" />

</androidx.constraintlayout.widget.ConstraintLayout>
