<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_50">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/headerReportes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TituloMediano"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_reportes" />

            <TextView
                android:textAppearance="@style/TextoSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/etiqueta_sucursal_centro" />
        </LinearLayout>

        <!-- Period Select Button -->
        <LinearLayout
            android:id="@+id/btnPeriod"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_period_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvPeriodLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/periodo_hoy"
                android:textColor="@color/char_700"
                android:textSize="12.5sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/desc_periodo"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerReportes">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Hero Sales Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/etiqueta_ventas_de_hoy_mayusculas"
                    android:textColor="@color/white_translucent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHeroSalesAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    tools:text="Bs 1,284.50"
                    android:textColor="@color/white"
                    android:textSize="32sp" />

                <LinearLayout
                    android:id="@+id/containerGrowthTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_delta_tag"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivTrendIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@string/desc_crecimiento"
                        android:src="@drawable/ic_trend_up" />

                    <TextView
                        android:id="@+id/tvGrowthRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/ejemplo_tasa_crecimiento"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stat Grid 2x2 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Stat 1: Pedidos Hoy -->
                <LinearLayout
                    style="@style/TarjetaEstadistica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/desc_pedidos"
                            android:src="@drawable/ic_nav_sale"
                            app:tint="@color/ember_600" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatPedidosHoy"
                        style="@style/TextoEstadisticaNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/etiqueta_pedidos_hoy"
                        android:textColor="@color/char_400"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Stat 2: Ticket Promedio -->
                <LinearLayout
                    style="@style/TarjetaEstadistica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/desc_ticket"
                            android:src="@drawable/ic_method_cash"
                            app:tint="@color/ember_600" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatTicketPromedio"
                        style="@style/TextoEstadisticaNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Bs 0.00" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/etiqueta_ticket_promedio"
                        android:textColor="@color/char_400"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Stat 3: Para Mesa -->
                <LinearLayout
                    style="@style/TarjetaEstadistica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/desc_en_local"
                            android:src="@drawable/ic_dining_local"
                            app:tint="@color/ember_600" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatParaMesa"
                        style="@style/TextoEstadisticaNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/etiqueta_en_el_local"
                        android:textColor="@color/char_400"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Stat 4: Hora Pico -->
                <LinearLayout
                    style="@style/TarjetaEstadistica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_method_icon_unselected">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/desc_hora_pico"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/ember_600" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatHoraPico"
                        style="@style/TextoEstadisticaNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="12-2pm" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/etiqueta_hora_pico"
                        android:textColor="@color/char_400"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </GridLayout>

            <!-- Section: Ventas por hora -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/etiqueta_ventas_por_hora_hoy"
                android:textColor="@color/char_900"
                android:textSize="15sp" />

            <!-- Hourly Sales Bar Chart Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_order_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <!-- Col 11a -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/barCol11a"
                            android:layout_width="18dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_chip_selected"
                            android:backgroundTint="@color/ember_100" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/hora_11a"
                            android:textColor="@color/char_400"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Col 12p -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/barCol12p"
                            android:layout_width="18dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_chip_selected"
                            android:backgroundTint="@color/ember_100" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/hora_12p"
                            android:textColor="@color/char_400"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Col 1p -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/barCol1p"
                            android:layout_width="18dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_chip_selected"
                            android:backgroundTint="@color/ember_100" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/hora_1p"
                            android:textColor="@color/char_400"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Col 2p -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/barCol2p"
                            android:layout_width="18dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_chip_selected"
                            android:backgroundTint="@color/ember_100" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/hora_2p"
                            android:textColor="@color/char_400"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Col 3p -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/barCol3p"
                            android:layout_width="18dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_chip_selected"
                            android:backgroundTint="@color/ember_100" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/hora_3p"
                            android:textColor="@color/char_400"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Col 4p -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/barCol4p"
                            android:layout_width="18dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_chip_selected"
                            android:backgroundTint="@color/ember_100" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/hora_4p"
                            android:textColor="@color/char_400"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Col 5p -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/barCol5p"
                            android:layout_width="18dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_chip_selected"
                            android:backgroundTint="@color/ember_100" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/hora_5p"
                            android:textColor="@color/char_400"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Productos más vendidos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/etiqueta_productos_mas_vendidos"
                android:textColor="@color/char_900"
                android:textSize="15sp" />

            <!-- Rank List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNoTopProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_order_card"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:text="@string/reportes_sin_ventas_semana"
                    android:textColor="@color/char_400"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Rank Item 1 (Top) -->
                <LinearLayout
                    android:id="@+id/rankItem1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_order_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_add_btn"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRank1Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            tools:text="1/4 pollo frito"
                            android:textColor="@color/char_900"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvRank1Sold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif"
                            tools:text="32 vendidos en la semana"
                            android:textColor="@color/char_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRank1Amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        tools:text="Bs 448.00"
                        android:textColor="@color/char_900"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Rank Item 2 -->
                <LinearLayout
                    android:id="@+id/rankItem2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_order_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_method_icon_unselected"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/ember_600"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRank2Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            tools:text="1/2 pollo a la brasa"
                            android:textColor="@color/char_900"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvRank2Sold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif"
                            tools:text="18 vendidos en la semana"
                            android:textColor="@color/char_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRank2Amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        tools:text="Bs 432.00"
                        android:textColor="@color/char_900"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Rank Item 3 -->
                <LinearLayout
                    android:id="@+id/rankItem3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_order_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_method_icon_unselected"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/ember_600"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRank3Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            tools:text="Combo familiar"
                            android:textColor="@color/char_900"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvRank3Sold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif"
                            tools:text="7 vendidos en la semana"
                            android:textColor="@color/char_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRank3Amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        tools:text="Bs 364.00"
                        android:textColor="@color/char_900"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Caja -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/etiqueta_caja"
                android:textColor="@color/char_900"
                android:textSize="15sp" />

            <!-- Cerrar Caja Row -->
            <LinearLayout
                android:id="@+id/btnCerrarCaja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_order_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_avatar_circle">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/desc_cerrar_caja"
                        android:src="@drawable/ic_cash_register" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
