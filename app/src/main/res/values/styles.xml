<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ======================================================== -->
    <!--  1. TIPOGRAFÍA Y ESTILOS DE TEXTO                        -->
    <!-- ======================================================== -->

    <style name="TextoBase" parent="android:TextAppearance" />
    <style name="TituloBase" parent="TextoBase" />

    <!-- Título Principal (Pantallas principales, Apertura) -->
    <style name="TituloPrincipal" parent="TituloBase">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/char_900</item>
        <item name="android:textSize">@dimen/text_size_hero</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Título Grande (Encabezados de bienvenida, recibo, recuperación) -->
    <style name="TituloGrande" parent="TituloBase">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/char_900</item>
        <item name="android:textSize">@dimen/text_size_title_large</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Título Mediano (Sección, Barra Superior o Modal) -->
    <style name="TituloMediano" parent="TituloBase">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/char_900</item>
        <item name="android:textSize">@dimen/text_size_title_medium</item>
    </style>

    <!-- Título Pequeño (Tarjeta o Item: Plato, Pedido, Turno) -->
    <style name="TituloPequeno" parent="TituloBase">
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/char_900</item>
        <item name="android:textSize">@dimen/text_size_title_small</item>
    </style>

    <!-- Subtítulo Estándar -->
    <style name="TextoSubtitulo" parent="TextoBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/char_400</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
    </style>

    <!-- Subtítulo Atenuado Pequeño -->
    <style name="SubtituloAtenuado" parent="TextoSubtitulo">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Subtítulo con Énfasis Oscuro -->
    <style name="SubtituloEnfasis" parent="TextoBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/char_700</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <!-- Subtítulo Oscuro -->
    <style name="SubtituloOscuro" parent="TextoSubtitulo">
        <item name="android:textColor">@color/char_700</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
    </style>

    <!-- Subtítulo con Acento de Marca -->
    <style name="SubtituloAcento" parent="TextoBase">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ember_600</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Etiqueta de Formulario -->
    <style name="TextoEtiqueta" parent="TextoBase">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/char_700</item>
        <item name="android:textSize">@dimen/text_size_label</item>
    </style>

    <!-- Etiqueta de Formulario en Negrita -->
    <style name="EtiquetaNegrita" parent="TextoEtiqueta">
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/char_700</item>
    </style>

    <!-- Texto de Cuerpo Estándar -->
    <style name="TextoCuerpo" parent="TextoBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/char_700</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <!-- Texto de Cuerpo Oscuro -->
    <style name="TextoCuerpoOscuro" parent="TextoCuerpo">
        <item name="android:textColor">@color/char_900</item>
    </style>

    <!-- Texto de Leyenda o Pie -->
    <style name="TextoLeyenda" parent="TextoBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/placeholder_text</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
    </style>

    <!-- Texto de Precio Principal -->
    <style name="TextoPrecio" parent="TextoBase">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/ember_600</item>
        <item name="android:textSize">@dimen/text_size_price_medium</item>
    </style>

    <!-- Texto de Precio Pequeño -->
    <style name="PrecioPequeno" parent="TextoPrecio">
        <item name="android:textColor">@color/ember_700</item>
        <item name="android:textSize">@dimen/text_size_price_small</item>
    </style>

    <!-- Texto de Insignia Mayúsculas -->
    <style name="TextoInsignia" parent="TextoBase">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_badge</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Texto de Insignia de Estado -->
    <style name="InsigniaEstado" parent="TextoInsignia">
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Texto de Navegación Inferior (Activo) -->
    <style name="NavegacionActiva" parent="TextoBase">
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/ember_600</item>
        <item name="android:textSize">@dimen/text_size_badge</item>
    </style>

    <!-- Texto de Navegación Inferior (Inactivo) -->
    <style name="NavegacionInactiva" parent="TextoBase">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/char_400</item>
        <item name="android:textSize">@dimen/text_size_badge</item>
    </style>


    <!-- ======================================================== -->
    <!--  2. BOTONES Y ACCIONES                                   -->
    <!-- ======================================================== -->

    <style name="BotonBase" parent="Widget.AppCompat.Button" />

    <!-- Botón Primario Estándar -->
    <style name="BotonPrimario" parent="BotonBase">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_btn_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">@dimen/spacing_xl</item>
        <item name="android:minHeight">@dimen/btn_height_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Botón Primario Principal / Hero -->
    <style name="BotonPrimarioPrincipal" parent="BotonPrimario">
        <item name="android:minHeight">@dimen/btn_height_hero</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:elevation">@dimen/elevation_medium</item>
    </style>

    <!-- Botón Primario Mediano -->
    <style name="BotonPrimarioMediano" parent="BotonPrimario">
        <item name="android:minHeight">@dimen/btn_height_medium</item>
        <item name="android:textSize">@dimen/text_size_btn_medium</item>
        <item name="android:paddingHorizontal">@dimen/spacing_l</item>
    </style>

    <!-- Botón Primario Pequeño -->
    <style name="BotonPrimarioPequeno" parent="BotonPrimario">
        <item name="android:minHeight">@dimen/btn_height_small</item>
        <item name="android:textSize">@dimen/text_size_btn_small</item>
        <item name="android:paddingHorizontal">@dimen/spacing_m</item>
    </style>

    <!-- Botón Secundario / Contorno -->
    <style name="BotonContorno" parent="BotonBase">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/char_700</item>
        <item name="android:textSize">@dimen/text_size_btn_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">@dimen/spacing_l</item>
        <item name="android:minHeight">@dimen/btn_height_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Botón Contorno Mediano -->
    <style name="BotonContornoMediano" parent="BotonContorno">
        <item name="android:minHeight">@dimen/btn_height_medium</item>
        <item name="android:paddingHorizontal">@dimen/spacing_l</item>
    </style>

    <!-- Botón Contorno Pequeño -->
    <style name="BotonContornoPequeno" parent="BotonContorno">
        <item name="android:minHeight">@dimen/btn_height_small</item>
        <item name="android:textSize">@dimen/text_size_btn_small</item>
        <item name="android:paddingHorizontal">@dimen/spacing_m</item>
    </style>

    <!-- Botón de Peligro / Cancelación -->
    <style name="BotonPeligro" parent="BotonBase">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/danger_600</item>
        <item name="android:textSize">@dimen/text_size_btn_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/btn_height_medium</item>
        <item name="android:paddingHorizontal">@dimen/spacing_l</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Botón Volver -->
    <style name="BotonVolver">
        <item name="android:layout_width">@dimen/btn_icon_size_small</item>
        <item name="android:layout_height">@dimen/btn_icon_size_small</item>
        <item name="android:background">@drawable/bg_back_btn</item>
        <item name="android:src">@drawable/ic_back_arrow</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:contentDescription">@string/desc_volver</item>
    </style>

    <!-- Botón Volver Grande -->
    <style name="BotonVolverGrande" parent="BotonVolver">
        <item name="android:layout_width">@dimen/btn_icon_size</item>
        <item name="android:layout_height">@dimen/btn_icon_size</item>
    </style>

    <!-- Botón de Monto Rápido en Efectivo -->
    <style name="BotonEfectivoRapido">
        <item name="android:background">@drawable/bg_quick_cash_btn</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/char_700</item>
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/btn_height_small</item>
    </style>

    <!-- Botón Contador (-) -->
    <style name="BotonContadorMenos" parent="BotonBase">
        <item name="android:layout_width">@dimen/btn_stepper_size</item>
        <item name="android:layout_height">@dimen/btn_stepper_size</item>
        <item name="android:background">@drawable/bg_minus_btn</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/ember_700</item>
        <item name="android:textSize">18sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Botón Contador (+) -->
    <style name="BotonContadorMas" parent="BotonBase">
        <item name="android:layout_width">@dimen/btn_stepper_size</item>
        <item name="android:layout_height">@dimen/btn_stepper_size</item>
        <item name="android:background">@drawable/bg_add_btn</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Chip / Filtro Seleccionado -->
    <style name="ChipSeleccionado">
        <item name="android:background">@drawable/bg_chip_selected</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/input_padding_horizontal</item>
        <item name="android:minHeight">@dimen/btn_height_compact</item>
    </style>

    <!-- Chip / Filtro No Seleccionado -->
    <style name="ChipNoSeleccionado">
        <item name="android:background">@drawable/bg_chip_unselected</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/char_700</item>
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/input_padding_horizontal</item>
        <item name="android:minHeight">@dimen/btn_height_compact</item>
    </style>


    <!-- ======================================================== -->
    <!--  3. CAMPOS DE ENTRADA Y FORMULARIOS                      -->
    <!-- ======================================================== -->

    <!-- Contenedor de Campo de Entrada -->
    <style name="ContenedorCampo">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingHorizontal">@dimen/input_padding_horizontal</item>
    </style>

    <!-- Campo de Texto Editable -->
    <style name="CampoTexto">
        <item name="android:background">@null</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/char_900</item>
        <item name="android:textColorHint">@color/placeholder_text</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>


    <!-- ======================================================== -->
    <!--  4. TARJETAS, CONTENEDORES Y BARRAS                      -->
    <!-- ======================================================== -->

    <!-- Encabezado Horizontal -->
    <style name="EncabezadoHorizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/white</item>
        <item name="android:elevation">@dimen/elevation_low</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/header_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/header_padding_top</item>
        <item name="android:paddingBottom">@dimen/header_padding_bottom</item>
    </style>

    <!-- Encabezado Vertical -->
    <style name="EncabezadoVertical">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/white</item>
        <item name="android:elevation">@dimen/elevation_low</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">@dimen/header_padding_horizontal</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">@dimen/header_padding_bottom</item>
    </style>

    <!-- Tarjeta de Producto -->
    <style name="TarjetaProducto">
        <item name="android:background">@drawable/bg_product_card</item>
        <item name="android:padding">@dimen/card_padding_product</item>
    </style>

    <!-- Tarjeta de Pedido / Turno -->
    <style name="TarjetaPedido">
        <item name="android:background">@drawable/bg_order_card</item>
        <item name="android:padding">@dimen/card_padding_standard</item>
    </style>

    <!-- Contenedor de Diálogo / Modal -->
    <style name="DialogoContenedor">
        <item name="android:background">@drawable/bg_card_top_rounded</item>
        <item name="android:padding">@dimen/dialog_padding</item>
    </style>

    <!-- Tarjeta Blanca con Borde -->
    <style name="TarjetaBlanca">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/line_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Divisor de Línea -->
    <style name="Divisor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line_color</item>
    </style>

    <!-- Barra de Navegación Inferior -->
    <style name="BarraNavegacion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/bottom_nav_height</item>
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="android:elevation">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Barra Flotante de Carrito -->
    <style name="BarraCarrito">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/bottom_nav_height</item>
        <item name="android:background">@drawable/bg_cart_bar</item>
        <item name="android:elevation">@dimen/elevation_high</item>
        <item name="android:paddingHorizontal">@dimen/card_margin_horizontal</item>
    </style>

    <!-- Contenedor de Búsqueda -->
    <style name="ContenedorBusqueda">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/input_height_compact</item>
        <item name="android:background">@drawable/bg_search</item>
    </style>


    <!-- ======================================================== -->
    <!--  5. COMPONENTES Y FILAS PARA CIERRE DE CAJA             -->
    <!-- ======================================================== -->

    <!-- Tarjeta de Contenedor de Cierre y Conteo -->
    <style name="TarjetaCierre">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="cardBackgroundColor">@color/paper_50</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Tarjeta de Alerta de Diferencia -->
    <style name="TarjetaAlerta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="cardBackgroundColor">@color/ok_100</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Contenedor Vertical de Tarjeta -->
    <style name="ContenedorTarjetaVertical">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <!-- Fila de Resumen Contable -->
    <style name="FilaResumen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Fila de Resumen con Espaciado Superior -->
    <style name="FilaResumenEspaciada" parent="FilaResumen">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Etiqueta de Fila de Resumen -->
    <style name="TextoFilaEtiqueta" parent="TextoBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/char_700</item>
    </style>

    <!-- Valor Numérico de Fila de Resumen -->
    <style name="TextoFilaValor" parent="TextoBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/char_900</item>
    </style>

    <!-- Divisor Suave Secundario -->
    <style name="DivisorSuave">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@color/paper_100</item>
    </style>

    <!-- Campo de Entrada de Efectivo en Cierre -->
    <style name="CampoEfectivoCierre">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:backgroundTint">@color/ember_100</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <!-- Texto de Monto de Efectivo Grande -->
    <style name="TextoMontoEfectivo" parent="TextoBase">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/char_900</item>
    </style>

    <!-- Título de Alerta -->
    <style name="TextoAlertaTitulo" parent="TextoBase">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ok_600</item>
    </style>

</resources>
