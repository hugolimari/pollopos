<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Pollogithub" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper_50</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Mapeo de Colores de Marca a Componentes Material 3 -->
        <item name="colorPrimary">@color/ember_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/ember_100</item>
        <item name="colorOnPrimaryContainer">@color/ember_700</item>
        <item name="colorSecondary">@color/char_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/paper_50</item>
        <item name="colorOnBackground">@color/char_900</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/char_900</item>
    </style>

    <style name="Theme.Pollogithub" parent="Base.Theme.Pollogithub" />
</resources>